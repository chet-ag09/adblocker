{
    "manifest_version": 3,
    "name": "Ad Blocker",
    "version": "1.0",
    "description": "remove ads and adds a 10x yt ad skip btn",
    "permissions": ["scripting"],
    "host_permissions": ["*://*/*", "https://www.youtube.com/*"],
    "content_scripts": [
      {
        "matches": ["*://*/*"],
        "js": ["content.js"],
        "css": ["styles.css"]
      }
    ],
    "icons": {
      "128": "icon.png"
    }
  }
  